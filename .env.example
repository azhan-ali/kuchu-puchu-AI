# ==========================================
# Kuchu Puchu AI - Environment Configuration
# ==========================================

# Groq API Key (Primary LLM for fast summary, takeaways, and RAG chat)
# Get your API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Recommended for high-fidelity Mermaid Mind Map & Flowchart generation)
# Get your API key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral AI API Key (Fallback provider for diagrams and text pipelines)
# Get your API key: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Sarvam AI API Key (Optional: for Hinglish / Indian language speech translation)
# Get your API key: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5

# HuggingFace API Key / Token (Optional: prevents download rate-limiting for embeddings)
# Get your token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Local Whisper Speech-to-Text Model (Options: tiny, base, small, medium, large-v3)
WHISPER_MODEL=small
