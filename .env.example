# ==========================================
# Kuchu Puchu AI - Environment Configuration
# ==========================================

# ── Required AI API Keys ──────────────────────────────────────────────────
# Groq API Key (Primary LLM for fast summary, takeaways, and RAG chat)
# Get your API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Recommended for high-fidelity Mermaid Mind Map & Flowchart generation)
# Get your API key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional Fallback & Multilingual Providers ───────────────────────────
# Mistral AI API Key (Fallback provider for diagrams and text pipelines)
# Get your API key: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Sarvam AI API Key (Optional: for Hinglish / Indian language speech translation)
# Get your API key: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5

# HuggingFace API Key / Token (Optional: prevents download rate-limiting for embeddings)
# Get your token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here

# ── Model & Processing Configuration ─────────────────────────────────────
# Groq Whisper Cloud STT Model (Options: whisper-large-v3-turbo, whisper-large-v3)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Local Whisper Speech-to-Text Model Fallback (Options: tiny, base, small, medium, large-v3)
# Note: 'base' or 'tiny' is recommended for CPU cloud deployments (<150MB RAM).
WHISPER_MODEL=base

# ── Deployment & Server Configuration ────────────────────────────────────
# Port will be automatically set by Railway / Render via $PORT (defaults to 8000)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Storage directories
DOWNLOAD_DIR=downloads
CHROMA_PERSIST_DIR=vector_db
